# Discord TTS (read-aloud) bot configuration.
# Copy this file to ".env" and fill in your values, then run the bot.

# REQUIRED. Your Discord bot token from the Discord Developer Portal.
# If this is absent the bot logs an error and exits with a non-zero status code.
DISCORD_TOKEN=

# The base URL of your locally running VOICEVOX Engine.
# Default (used when omitted): http://127.0.0.1:50021
VOICEVOX_URL=http://127.0.0.1:50021

# The default VOICEVOX Speaker_ID (character/style) used for synthesis.
# Default (used when omitted): 3  (Zundamon - Normal)
DEFAULT_SPEAKER=3

# The character sequence that identifies a message as a bot command.
# Default (used when omitted): !
COMMAND_PREFIX=!

# The maximum number of spoken characters read aloud per message.
# Messages longer than this are truncated with an omission marker.
# Default (used when omitted): 100
READING_LIMIT=100
